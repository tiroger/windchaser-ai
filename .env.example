# Strava API credentials. Copy this file to .env and fill in real values.
# .env is gitignored; this example file is not.
#
# 1. Create an application at https://www.strava.com/settings/api
# 2. Authorize it with scopes: read,activity:read_all,profile:read_all
# 3. Exchange the returned code for a refresh token
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Optional. Centre point for segment discovery.
# Defaults to the centroid of your starred segments when unset.
WINDCHASER_EXPLORE_LAT=
WINDCHASER_EXPLORE_LON=

# Optional. Discovery radius in kilometres.
WINDCHASER_EXPLORE_RADIUS_KM=12

# Optional. Cap on how many discovered segments get a detail fetch.
# Each costs one Strava API call, so keep it modest.
WINDCHASER_EXPLORE_LIMIT=12
